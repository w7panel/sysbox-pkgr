[Unit]
Description=sysbox-snapshotter (containerd proxy snapshotter for Sysbox rootfs persistence)
PartOf=sysbox.service
After=sysbox-mgr.service sysbox-fs.service
Before=containerd.service

[Service]
Type=simple
ExecStart=/usr/bin/sysbox-snapshotter --socket /run/sysbox-snapshotter.sock --root /var/lib/rancher/k3s/agent/containerd/io.containerd.snapshotter.v1.sysbox --containerd-socket /run/k3s/containerd/containerd.sock
TimeoutStartSec=45
TimeoutStopSec=90
StartLimitInterval=0
OOMScoreAdjust=-500
LimitNOFILE=infinity
LimitNPROC=infinity

[Install]
WantedBy=sysbox.service
